{
  "Entra": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "common",
    "ClientId": "<your-client-id>",
    "ClientSecret": "<your-client-secret>",
    "Audience": "api://<your-client-id>",
    "ApiScope": "Mcp.Read"
  },
  "Graph": {
    "BaseUrl": "https://graph.microsoft.com/v1.0",
    "Scopes": [
      "https://graph.microsoft.com/Community.Read.All",
      "https://graph.microsoft.com/EngagementRole.Read",
      "https://graph.microsoft.com/User.Read"
    ]
  },
  "VivaEngage": {
    "BaseUrl": "https://www.yammer.com/api/v1",
    "UseEntraTokens": true,
    "DelegatedPermissionName": "access_as_user",
    "RequestedScopeOrResource": "https://api.yammer.com/user_impersonation"
  },
  "Mcp": {
    "EndpointPath": "/mcp",
    "ServerName": "viva-engage-mcp",
    "ServerVersion": "0.1.0"
  },
  "AllowedOrigins": [
    "http://localhost",
    "https://localhost"
  ]
}
